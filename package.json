{
  "name": "scope",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.cjs --network baseSepolia",
    "contracts:deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "contracts:node": "hardhat node",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.13",
    "@coinbase/wallet-sdk": "^4.4.0",
    "@metamask/connect-evm": "^2.1.1",
    "@prisma/client": "^5.22.0",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "^5.103.2",
    "@walletconnect/ethereum-provider": "^2.25.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^14.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.21.45",
    "wagmi": "^3.7.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.3",
    "hardhat": "^2.22.16",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
